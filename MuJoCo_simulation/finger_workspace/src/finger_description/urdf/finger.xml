<mujoco model="urdf_exports2">
  <compiler angle="radian"/>
  <option gravity="0.0 0.0 -9.81"/>

  <asset>
    <!--Finger assets-->
    <material name="base_mat"  rgba="0.8 0.2 0.2 1" emission="0.3"/>   <!-- red -->
    <material name="splay_mat" rgba="0.2 0.4 0.3 1" emission="0.3"/>   <!-- blue -->
    <material name="mcp_mat"   rgba="0.2 0.3 0.3 1" emission="0.3"/>   <!-- green -->
    <material name="pip_mat"   rgba="0.4 0.3 0.1 1" emission="0.3"/>
    <mesh name="base_link" content_type="model/stl" file="../meshes/base_link.STL"/>
    <mesh name="splay_link" content_type="model/stl" file="../meshes/splay_link.STL"/>
    <mesh name="mcp_link" content_type="model/stl" file="../meshes/mcp_link.STL"/>
    <mesh name="pip_link" content_type="model/stl" file="../meshes/pip_link.STL"/>
    <!--Ball pendulum asset-->
    <material name="rod_mat" rgba="0.3 0.3 0.3 1" emission="0.3"/>
    <material name="ball_mat" rgba="0.3 0.3 0.3 1" emission="0.3"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" diffuse="1 1 1" specular="0.3 0.3 0.3" directional="true"/>
    <geom name="floor" type="plane" size="1 1 0.1" rgba="0.8 0.8 0.8 0.7"/>

    <!-- Add ball setup -0.225 -->
    <body name="pendulum_support" pos = "-0.12476 0.0 0.12">
      <!--<inertial pos="0 -0.258 0.058" mass="0.1" diaginertia="1e-4 1e-4 1e-4"/>-->
      <geom type="box" size="0.008 0.008 0.008" rgba="0.5 0.5 0.5 1"/>
      
      <body name="pendulum_rod" pos="0 0 0">
        <joint name="pendulum_joint" type="hinge" axis="1 0 0" pos="0 0 0" damping="0.1"/>
        <inertial pos="0 0 -0.05" mass="0.5" diaginertia="1e-3 1e-3 1e-3"/>
        <geom type="cylinder" size="0.004 0.05" pos ="0 0 -0.05" material="rod_mat"/>

        <body name="ball" pos="0 0 -0.1">
          <inertial pos="0 0 0" mass="0.05" diaginertia="1e-3 1e-3 1e-3"/>
          <geom name="ball_geom" type="sphere" size="0.015" material="ball_mat"/>
        </body>

      </body>
    </body>
    
    <body name="base_link" pos="0 0 0.01" euler="1.57 0 1.57">
      <inertial pos="0 0 0" mass="0.1" diaginertia="1e-4 1e-4 1e-4"/>
      <geom type="mesh" material="base_mat" mesh="base_link"/>
      
      <body name="splay_link" pos="0.01504 0.018 0.016">
        <inertial pos="-3.6026e-05 0.0074618 0.0080911" quat="0.540632 -0.194088 0.25543 0.77769" mass="0.015542" diaginertia="1.41539e-06 1.4041e-06 1.2375e-06"/>
        <joint name="splay_joint" pos="0 0 0" axis="0 0 1" range="-0.35 0.35" damping="0.5" stiffness="2.0"/>
        <geom type="mesh" material="splay_mat" mesh="splay_link"/>
        
        <body name="mcp_link" pos="0.00015675 0.029856 0">
          <inertial pos="-4.0155e-05 0.019564 0.004554" quat="0.51097 0.473652 -0.492558 0.521488" mass="0.022212" diaginertia="3.60499e-06 2.80936e-06 2.37004e-06"/>
          <joint name="mcp_joint" pos="0 0 0" axis="-1 0 0" range="-1.57 1.57" actuatorfrcrange="-1 1" damping="0.5"/>
          <geom type="mesh" material="mcp_mat" mesh="mcp_link"/>
          
          <body name="pip_link" pos="0.00022576 0.042999 0">
            <inertial pos="9.3176e-05 0.02496 5.2699e-05" quat="0.627101 0.32874 -0.334425 0.62196" mass="0.026546" diaginertia="5.11105e-06 4.55235e-06 3.1275e-06"/>
            <joint name="pip_joint" pos="0 0 0" axis="-1 0 0" range="-1.57 1.57" actuatorfrcrange="-1 1" damping="0.5"/>
            <geom name="pip_geom" type="mesh" material="pip_mat" mesh="pip_link"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <!-- Set initial Positions -->
  <keyframe>
    <key name="start" qpos="1.5 0 0 0"/>
  </keyframe>
  <!-- Adding motors (actuators)-->
  <actuator>
    <position name="splay_motor" joint="splay_joint" ctrlrange="-0.35 0.35" kp="10" kv="1.25"/>
    <motor name="mcp_motor"   joint="mcp_joint"   ctrlrange="-2 2" ctrllimited="true"/>
    <motor name="pip_motor"   joint="pip_joint"   ctrlrange="-2 2" ctrllimited="true"/>
  </actuator>

</mujoco>
